# ===== Core (required) =====
NODE_ENV=development
PORT=4000
# Local dev cluster (see README) or your own Postgres:
DATABASE_URL=postgresql://sathi@localhost:5434/sathi
REDIS_URL=redis://localhost:6379
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 32 random bytes, base64. REQUIRED in production (encrypts Google OAuth tokens at rest).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
# Set to the number of reverse proxies in front of the API in production (e.g. 1)
TRUST_PROXY=0
UPLOAD_DIR=uploads
# debug | info | warn | error | silent (default: debug in development, info in production, silent in tests)
# LOG_LEVEL=info
# Set to true to disable the in-process hold/expiry sweeps that run in development when no worker is running
DISABLE_DEV_MAINTENANCE=false

# ===== Email (optional; dev adapter logs to console when EMAIL_HOST is empty) =====
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Sathi <no-reply@sathi.local>"

# ===== Push notifications (optional, Firebase Cloud Messaging HTTP v1) =====
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ===== Payments =====
# eSewa ePay v2 public sandbox values (UAT). Replace with merchant credentials for production.
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
ESEWA_BASE_URL=https://rc-epay.esewa.com.np
# Khalti: test secret key from https://test-admin.khalti.com (leave empty to disable Khalti)
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2

# ===== Google Meet via Google Calendar API (counselor OAuth) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/meetings/google/callback
# Development-only manual meeting links when Google is not configured (always disabled in production)
ALLOW_DEV_MANUAL_MEETINGS=true

# ===== Community moderation =====
# local (rules, EN+NE) | perspective (Google Perspective API for English + local rules)
MODERATION_PROVIDER=local
PERSPECTIVE_API_KEY=

# ===== Storage (production: S3-compatible driver to be configured; see docs/deployment.md) =====
STORAGE_DRIVER=local
CLOUD_STORAGE_BUCKET=
CLOUD_STORAGE_KEY=
CLOUD_STORAGE_SECRET=
